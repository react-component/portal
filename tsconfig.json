{
  "compilerOptions": {
    "target": "esnext",
    "strict": false,
    "types": ["node", "jest"],
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "paths": {
      "@/*": ["./src/*"],
      "@@/*": ["./.dumi/tmp/*"],
      "@rc-component/portal": ["./src/Portal.tsx"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".dumirc.ts"],
  "exclude": ["node_modules", "es", "lib", "dist", "docs-dist", ".doc", ".dumi/tmp", "coverage"]
}
